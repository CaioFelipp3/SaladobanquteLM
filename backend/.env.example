# ═══════════════════════════════════════════════════════════════
# MERCADO PAGO
# ═══════════════════════════════════════════════════════════════

# Obtenha em: https://www.mercadopago.com.br/developers/dashboard
# Credenciais → Produção
MERCADO_PAGO_PUBLIC_KEY=APP_USR_sua_chave_publica_aqui
MERCADO_PAGO_ACCESS_TOKEN=APP_USR_seu_access_token_aqui

# WEBHOOK_SECRET: Gere uma string aleatória forte para validar webhooks
# Exemplo: openssl rand -hex 32
# CRÍTICO: Guarde em local seguro, nunca compartilhe
WEBHOOK_SECRET=sua_webhook_secret_aqui_minimo_32_caracteres

# ADMIN_TOKEN: Token para acessar endpoints protegidos
# Exemplo: openssl rand -hex 32
ADMIN_TOKEN=seu_admin_token_aqui_minimo_32_caracteres

# ═══════════════════════════════════════════════════════════════
# EMAIL (Gmail)
# ═══════════════════════════════════════════════════════════════

# Seu email Gmail
EMAIL_USER=seu_email@gmail.com

# Senha de app (NÃO use a senha da sua conta!)
# Gere em: https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=sua_app_password_aqui

# ═══════════════════════════════════════════════════════════════
# FRONTEND
# ═══════════════════════════════════════════════════════════════

# URL do seu frontend (para validação de CORS)
# Em desenvolvimento: http://localhost:3000
# Em produção: https://saladobanquete.com.br
FRONTEND_URL=https://saladobanquete.com.br

# URL do backend (para redirecionamentos)
BACKEND_URL=https://seu-dominio.com/api

# ═══════════════════════════════════════════════════════════════
# CONFIGURAÇÃO DO SERVIDOR
# ═══════════════════════════════════════════════════════════════

# Porta onde o servidor rodará
PORT=3000

# Ambiente: development ou production
# ⚠️ Sempre use 'production' em deploy real
NODE_ENV=development

# ═══════════════════════════════════════════════════════════════
# SEGURANÇA - IMPORTANTE!
# ═══════════════════════════════════════════════════════════════

# NUNCA commite este arquivo!
# Use variáveis de ambiente reais em produção
# Proteja este arquivo com permissões: chmod 600 .env
