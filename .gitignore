# Variáveis de ambiente (sensível) — todas as variantes que o Next.js carrega
# (.env, .env.local, .env.production, .env.development...), exceto os exemplos
.env*
!.env.example

# Dependências
node_modules/
yarn.lock

# Next.js
.next/
out/
build/
next-env.d.ts
*.tsbuildinfo

# Vercel (estado local de link do projeto — não é segredo, mas não deve ser versionado)
.vercel

# Certificados e chaves privadas (ex: HTTPS em dev, certificados de APIs)
*.pem
*.key
*.crt
*.cer
*.der
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*

# Bancos de dados locais, dumps e exportações (podem conter dados pessoais)
*.db
*.sqlite
*.sqlite3
*.sql
*.dump
dumps/
backups/
*.csv
*.xlsx

# Relatórios do gitleaks (repetem o trecho do segredo encontrado)
gitleaks-report.*

# Claude Code: permissões de comandos são pessoais (caminhos da máquina de cada um)
.claude/settings.json
.claude/settings.local.json

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Backups
*.bak
*.backup

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Cache e relatórios de teste
.cache/
.eslintcache
coverage/

