# Variáveis de ambiente (sensível) — todas as variantes que o Next.js carrega
# (.env, .env.local, .env.production, .env.development...), exceto os exemplos
.env*
!.env.example

# Dependências
node_modules/
yarn.lock

# Banco de dados local (contém PII) — inclui quarentena/rotação e temporários de escrita atômica
transacoes*.json
.transacoes*.tmp

# Next.js
.next/
out/
build/
next-env.d.ts
*.tsbuildinfo

# Vercel (estado local de link do projeto — não é segredo, mas não deve ser versionado)
.vercel

# Certificados locais (ex: HTTPS em dev)
*.pem

# Claude Code: permissões de comandos são pessoais (caminhos da máquina de cada um)
.claude/settings.json

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Backups
*.bak
*.backup

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Cache e relatórios de teste
.cache/
.eslintcache
coverage/

